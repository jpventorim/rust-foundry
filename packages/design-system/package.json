{
  "name": "@rust-foundry/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Tactile, accessible building blocks for tabletop adventures",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "styles": "panda codegen && panda cssgen --outfile styled-system/styles.css",
    "styles:watch": "panda cssgen --watch --outfile styled-system/styles.css",
    "build": "bun run styles && rslib build && tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.tooling.json --noEmit",
    "storybook": "bun run styles && storybook dev --port 6006 --no-open --disable-telemetry",
    "build-storybook": "bun run styles && storybook build --disable-telemetry",
    "test": "bun run build-storybook && bun run test:browser",
    "test:browser": "rstest run",
    "test:watch": "rstest watch"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "lucide-react": "^1.69.0"
  },
  "devDependencies": {
    "@pandacss/dev": "^2.5.0",
    "@rsbuild/core": "^2.3.1",
    "@rsbuild/plugin-react": "^2.1.1",
    "@rslib/core": "^1.0.6",
    "@rstest/core": "^0.12.6",
    "@storybook/addon-a11y": "^10.6.6",
    "@storybook/addon-docs": "^10.6.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0",
    "playwright": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.6",
    "storybook-react-rsbuild": "^3.6.2",
    "typescript": "~7.0.2"
  }
}
